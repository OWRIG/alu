{
  "name": "alu",
  "version": "0.2.1",
  "private": true,
  "description": "ALU — agent-friendly industrial aluminum-extrusion design workspace",
  "homepage": "https://github.com/OWRIG/alu",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "OWRIG",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWRIG/alu.git"
  },
  "bin": {
    "alu": "dist/cli/alu.mjs"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && pnpm build:cli",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "node dist/cli/alu.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm boundaries",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cli": "pnpm build:cli && node scripts/cli-smoke.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "docs:screenshots": "pnpm build && node scripts/capture-doc-screenshots.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "package:dir": "pnpm build && electron-builder --dir --arm64",
    "package:mac": "pnpm icon:build && pnpm build && electron-builder --mac dmg zip --arm64",
    "package:verify": "node scripts/check-package.mjs",
    "ready": "pnpm check && pnpm test:run && pnpm build && node scripts/cli-smoke.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.52.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "~43.3.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.577.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.0",
    "zustand": "^5.0.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
