{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vite.cli.config.ts",
    "src/cli/**/*",
    "src/domain/**/*",
    "src/main/**/*",
    "src/node/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/test-support/**/*",
    "e2e/**/*",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "noImplicitAny": true,
    "allowImportingTsExtensions": true,
    "types": ["electron-vite/node", "node", "vitest/globals"]
  }
}
